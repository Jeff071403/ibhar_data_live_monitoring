# Environment Configuration for IBHAR Live Monitoring Backend

DJANGO_SECRET_KEY=django-insecure-default-key-change-it-in-production
DEBUG=True

# Supabase PostgreSQL Database Settings
# Set DB_ENGINE=postgresql to connect to Supabase PostgreSQL, or DB_ENGINE=sqlite for local development fallback
DB_ENGINE=sqlite
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_database_password
DB_HOST=your_supabase_database_host
DB_PORT=5432

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
